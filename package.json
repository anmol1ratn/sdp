{
  "name": "cloudflare-sveltekit-starter",
  "version": "0.1.0",
  "private": true,
  "license": "MIT",
  "type": "module",
  "packageManager": "pnpm@11.25.0",
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "dev": "vite dev",
    "build": "vite build",
    "preview": "vite preview",
    "dev:worker": "pnpm build && wrangler dev .svelte-kit/cloudflare/_worker.js",
    "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
    "format": "biome check --write .",
    "format:check": "biome format .",
    "lint": "biome lint .",
    "verify": "biome ci . && pnpm check && pnpm test:unit && pnpm build",
    "test": "pnpm test:unit && pnpm test:e2e",
    "test:unit": "vitest run",
    "test:unit:watch": "vitest",
    "test:e2e": "pnpm db:migrate:local && pnpm db:seed:test && playwright test",
    "db:generate": "drizzle-kit generate",
    "db:migrate:local": "wrangler d1 migrations apply DB --local",
    "db:seed:test": "wrangler d1 execute DB --local --file tests/fixtures/test-user.sql",
    "db:migrate:remote": "wrangler d1 migrations apply DB --remote --env=\"\"",
    "deploy": "pnpm build && wrangler deploy --env=\"\"",
    "cf:typegen": "wrangler types"
  },
  "dependencies": {
    "@better-auth/drizzle-adapter": "1.7.2",
    "better-auth": "1.7.2",
    "drizzle-orm": "0.45.2",
    "zod": "4.5.4"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.12",
    "@cloudflare/workers-types": "5.20260905.1",
    "@playwright/test": "1.63.0",
    "@sveltejs/adapter-cloudflare": "7.2.9",
    "@sveltejs/kit": "2.70.3",
    "@sveltejs/vite-plugin-svelte": "7.3.0",
    "@tailwindcss/vite": "4.3.3",
    "@types/node": "24.13.3",
    "@vitest/coverage-v8": "4.1.11",
    "drizzle-kit": "0.31.10",
    "svelte": "5.57.0",
    "svelte-check": "4.7.6",
    "tailwindcss": "4.3.3",
    "typescript": "6.0.3",
    "vite": "8.2.2",
    "vitest": "4.1.11",
    "wrangler": "4.129.0"
  }
}
