{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "design-practice",
  "account_id": "4f3d68f181ec95f7b01a7585e7945c5c",
  "vars": {
    "AUTH_MODE": "cloudflare-access",
    "ACCESS_TEAM_DOMAIN": "https://winter-shape-af8d.cloudflareaccess.com",
    "ACCESS_AUD": "04f107c83fa3504bf19bc5d2dc1cf52cd974c62a624beae9e29855fd99995cfa",
    "PRACTICE_ALLOWED_EMAILS": "anmol1ratn@gmail.com,tyagi.anant@hotmail.com"
  },
  "main": "worker.js",
  "compatibility_date": "2026-09-05",
  "compatibility_flags": ["nodejs_compat"],
  "durable_objects": {
    "bindings": [{ "name": "IMAGE_VALIDATOR", "class_name": "ImageValidator" }]
  },
  "migrations": [{ "tag": "image-validator-v1", "new_sqlite_classes": ["ImageValidator"] }],
  "assets": {
    "binding": "ASSETS",
    "directory": ".svelte-kit/cloudflare"
  },
  "r2_buckets": [{ "binding": "ATTACHMENTS", "bucket_name": "design-practice-attachments" }],
  "observability": {
    "enabled": true
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "design-practice-db",
      "database_id": "ab330239-e63e-4642-8d0d-0e1c8caf6bbe",
      "migrations_dir": "migrations"
    }
  ],
  "env": {
    "preview": {
      "name": "cloudflare-sveltekit-starter-preview",
      "durable_objects": {
        "bindings": [{ "name": "IMAGE_VALIDATOR", "class_name": "ImageValidator" }]
      },
      "r2_buckets": [
        { "binding": "ATTACHMENTS", "bucket_name": "design-practice-attachments-preview" }
      ],
      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "cloudflare-sveltekit-starter-preview",
          "database_id": "11111111-1111-1111-1111-111111111111",
          "migrations_dir": "migrations"
        }
      ]
    }
  }
}
